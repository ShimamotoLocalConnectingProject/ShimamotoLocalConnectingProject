# ==============================================
# Shimamoto Stamp App - Environment Variables
# ==============================================

# Node Environment
NODE_ENV=development
PORT=3000

# ==============================================
# Database (PostgreSQL RECOMMENDED)
# ==============================================
# PostgreSQL (Recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/shimamoto_stamp

# MySQL (Alternative)
# DATABASE_URL=mysql://user:password@localhost:3306/shimamoto_stamp

# ==============================================
# JWT Authentication (CRITICAL SECURITY)
# ==============================================
# IMPORTANT: Must be at least 32 characters in production
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# ==============================================
# OAuth Providers (Optional)
# ==============================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ==============================================
# Web Push Notifications (Optional)
# ==============================================
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@shimamoto-stamp.app

# ==============================================
# AWS S3 / Cloudflare R2 (Optional)
# ==============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ==============================================
# SECURITY CHECKLIST FOR PRODUCTION
# ==============================================
# ✅ JWT_SECRET is at least 32 characters
# ✅ JWT_SECRET doesn't contain "change-this" or "your-secret"
# ✅ DATABASE_URL uses SSL/TLS connection
# ✅ OAuth credentials are from production apps
# ✅ VAPID keys are generated (if using notifications)
# ✅ All secrets are stored in environment (not committed to git)
